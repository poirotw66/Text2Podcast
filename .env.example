# Environment variables read by the backend (backend/app/...). Copy this file to
# `backend/.env` (the backend loads .env via python-dotenv from its own working
# directory — see backend/README.md) and fill in real values there. Never commit
# real secret values; this file must only ever contain placeholders.

# --- Required -----------------------------------------------------------------

# OpenAI API key used for transcript generation (backend/app/services/llm_service.py).
OPENAI_API_KEY=sk-your-openai-api-key

# Path to a Google Cloud service-account JSON key file, used by the
# google-cloud-texttospeech client for audio synthesis
# (backend/app/services/audio_service.py). Standard Google Cloud SDK variable —
# read implicitly by the google-cloud-texttospeech client library, not by our code.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# --- Optional -------------------------------------------------------------------

# OpenAI model used for transcript generation and optimization. Defaults to
# gpt-5-mini. Models whose name starts with "gpt-5" are called without a custom
# `temperature` (the API rejects it for those models).
OPENAI_MODEL=gpt-5-mini

# Google Cloud project ID. Only needed if it can't be inferred from the service
# account credentials above.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Comma-separated list of allowed CORS origins for the frontend
# (backend/app/main.py). Defaults to the two local dev servers below. Credentials
# (cookies/auth headers) are only allowed cross-origin when this is not "*".
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Shared-secret auth for the mutating/expensive endpoints (/api/upload, /api/step1,
# /api/step2, /api/step3) — backend/app/api/routes.py. When set, callers must send a
# matching `X-API-Key` header. When unset (the default), those endpoints stay open,
# so local development is unaffected.
API_KEY=

# Per-client-IP rate limiting for the same expensive endpoints
# (backend/app/api/routes.py). RATE_LIMIT_MAX_REQUESTS requests are allowed per
# RATE_LIMIT_WINDOW_SECONDS-second sliding window, per client IP.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20

# TaskManager in-memory task store tuning (backend/app/services/task_manager.py).
# Tasks are evicted (and their backend/outputs/<task_id>/ directory removed) once
# they're older than TASK_TTL_SECONDS since their last update, or once the total
# task count exceeds TASK_MAX_COUNT (oldest-updated evicted first).
TASK_TTL_SECONDS=86400
TASK_MAX_COUNT=1000

# SSE (/api/stream/{task_id}) tuning — backend/app/api/routes.py.
# SSE_STREAM_TIMEOUT_SECONDS bounds how long a single stream connection can stay
# open (so a wedged task can't leak a connection forever). SSE_KEEPALIVE_INTERVAL_SECONDS
# is how often an idle stream sends a keep-alive comment so intermediary proxies
# don't close it for inactivity.
SSE_STREAM_TIMEOUT_SECONDS=1800
SSE_KEEPALIVE_INTERVAL_SECONDS=15

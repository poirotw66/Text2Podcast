# Environment variables read by the backend (backend/app/...). Copy this file to
# `backend/.env` (the backend loads .env via python-dotenv from its own working
# directory — see backend/README.md) and fill in real values there. Never commit
# real secret values; this file must only ever contain placeholders.

# --- Required -----------------------------------------------------------------

# This project uses TWO Google/OpenAI-family providers for two different jobs:
#   - Script writing (Step 1/2, backend/app/services/llm/) -- LLM_PROVIDER below,
#     defaults to Gemini. Selectable, see LLM_PROVIDER in the Optional section.
#   - Text-to-speech (Step 3, backend/app/services/audio_service.py) -- always
#     Google Cloud TTS (gemini-2.5-flash-tts). Not configurable, not covered by
#     LLM_PROVIDER.

# Path to a Google Cloud service-account JSON key file. Always required: used by
# the google-cloud-texttospeech client for audio synthesis
# (backend/app/services/audio_service.py), and, when LLM_PROVIDER=gemini falls
# back to Vertex AI (no GEMINI_API_KEY set -- see below), reused as the Vertex AI
# credentials too. Standard Google Cloud SDK variable, read implicitly by both
# the google-cloud-texttospeech and google-genai client libraries, not by our code.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# --- Optional (but effectively required depending on LLM_PROVIDER) -------------

# Which provider writes the podcast script (backend/app/services/llm/factory.py).
# "gemini" (the default) or "openai". Unset = "gemini".
LLM_PROVIDER=gemini

# --- Gemini script-writing config (used when LLM_PROVIDER=gemini, the default) -

# API key for the Gemini Developer API (backend/app/services/llm/gemini_service.py).
# GOOGLE_API_KEY also works if you already use that name elsewhere. If NEITHER is
# set, GeminiLLMService falls back to Vertex AI using GOOGLE_CLOUD_PROJECT below
# plus the GOOGLE_APPLICATION_CREDENTIALS service account already required above
# for TTS -- so a Gemini-only setup needs either this key, or GOOGLE_CLOUD_PROJECT,
# but not both.
GEMINI_API_KEY=your-gemini-api-key

# Gemini model used for transcript generation and optimization. Defaults to
# gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud project ID. Used as the Vertex AI fallback for Gemini script
# writing when GEMINI_API_KEY/GOOGLE_API_KEY is unset, and (independently) may
# also help google-cloud-texttospeech if it can't be inferred from the service
# account credentials above.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI location/region, only relevant when GeminiLLMService is using the
# Vertex AI fallback described above. Defaults to "global".
GOOGLE_CLOUD_LOCATION=global

# --- OpenAI script-writing config (only used when LLM_PROVIDER=openai) ---------

# OpenAI API key used for transcript generation (backend/app/services/llm/openai_service.py).
# Only required when LLM_PROVIDER=openai; not read at all when using the default
# Gemini provider.
OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI model used for transcript generation and optimization. Defaults to
# gpt-5-mini. Models whose name starts with "gpt-5" are called without a custom
# `temperature` (the API rejects it for those models).
OPENAI_MODEL=gpt-5-mini

# --- Other optional settings ----------------------------------------------------

# Comma-separated list of allowed CORS origins for the frontend
# (backend/app/main.py). Defaults to the two local dev servers below. Credentials
# (cookies/auth headers) are only allowed cross-origin when this is not "*".
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Shared-secret auth for the mutating/expensive endpoints (/api/upload, /api/step1,
# /api/step2, /api/step3) — backend/app/api/routes.py. When set, callers must send a
# matching `X-API-Key` header. When unset (the default), those endpoints stay open,
# so local development is unaffected.
API_KEY=

# Per-client-IP rate limiting for the same expensive endpoints
# (backend/app/api/routes.py). RATE_LIMIT_MAX_REQUESTS requests are allowed per
# RATE_LIMIT_WINDOW_SECONDS-second sliding window, per client IP.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20

# TaskManager in-memory task store tuning (backend/app/services/task_manager.py).
# Tasks are evicted (and their backend/outputs/<task_id>/ directory removed) once
# they're older than TASK_TTL_SECONDS since their last update, or once the total
# task count exceeds TASK_MAX_COUNT (oldest-updated evicted first).
TASK_TTL_SECONDS=86400
TASK_MAX_COUNT=1000

# SSE (/api/stream/{task_id}) tuning — backend/app/api/routes.py.
# SSE_STREAM_TIMEOUT_SECONDS bounds how long a single stream connection can stay
# open (so a wedged task can't leak a connection forever). SSE_KEEPALIVE_INTERVAL_SECONDS
# is how often an idle stream sends a keep-alive comment so intermediary proxies
# don't close it for inactivity.
SSE_STREAM_TIMEOUT_SECONDS=1800
SSE_KEEPALIVE_INTERVAL_SECONDS=15
